# =============================================================================
# HEP Energy Monitor — primjer konfiguracije
# Kopiraj u .env i popuni svojim podacima (`cp .env.example .env`).
# Sve postavke se kasnije mogu mijenjati kroz UI (Postavke tab).
# =============================================================================

# --- HEP ODS (mjerenje.hep.hr) — OBAVEZNO ---
HEP_USERNAME=vas@email.hr
HEP_PASSWORD=lozinka
HEP_SIFRA=sifra_mjernog_mjesta

# --- SMA Sunny Portal (opcionalno, samo za solarne) ---
SMA_USERNAME=
SMA_PASSWORD=
SMA_CLIENT_ID=SPpbeOS
SMA_PLANT_ID=
SMA_INV1_ID=
SMA_INV2_ID=

# --- Home Assistant integracija (opcionalno) ---
HA_URL=
HA_TOKEN=

# --- Dashboard ---
DASHBOARD_PASSWORD=
INITIAL_ADMIN_PASSWORD=admin   # prvi admin korisnik kod prvog bootovanja

# --- Aplikacija (OBAVEZNO postaviti) ---
SECRET_KEY=
# Generiraj: python -c "import secrets; print(secrets.token_hex(32))"
DB_PATH=/data/hep_energy.db

# --- Tarife (HRK→EUR, default-i postavljeni) ---
TARIFA_VT=0.131205
TARIFA_NT=0.064379
TARIFA_PROD=0.064379
TARIFA_PDV=13
TARIFA_VT_OD=7
TARIFA_VT_DO=21

# --- Branding (opcionalno — vlastiti naziv/kontakt u footeru) ---
BRAND_NAME=Energy Monitor
BRAND_TAGLINE=
BRAND_OWNER=
BRAND_LOCATION=
BRAND_EMAIL=
BRAND_PHONE=
BRAND_WEB=

# --- Off-site backup (opcionalno — vidi ONEDRIVE_SETUP.md) ---
OFFSITE_BACKUP_MODE=disabled       # rclone | rsync | disabled
OFFSITE_BACKUP_DEST=
OFFSITE_BACKUP_KEEP=30
